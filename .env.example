APP_NAME=StarSystem
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
# docker compose: MariaDB 10.11 on 33110, MySQL 8.0 on 33080
DB_PORT=33110
DB_DATABASE=starsystem
DB_USERNAME=starsystem
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# StarDust: "shared" runs a budgeted tick from cron or the tick URL;
# "server" runs the four daemons (php artisan stardust:daemon <name>).
STARDUST_PROFILE=shared
STARDUST_TICK_BUDGET=40
STARDUST_QUEUE_SECONDS=15
STARDUST_TICK_URL_BUDGET=25
STARDUST_TICK_EXPORTS=true
# Enables /_system/tick for hosts without cron. Leave empty to disable.
STARDUST_TICK_SECRET=
STARDUST_TICK_STALE_AFTER=15
# STARDUST_LOCK_NAMESPACE=
# STARDUST_ARTIFACT_DIR=
# STARDUST_PID_DIR=

STARSYSTEM_MULTISITE=false

VITE_APP_NAME="${APP_NAME}"
