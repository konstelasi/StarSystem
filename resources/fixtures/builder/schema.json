{
    "version": 1,
    "model": {
        "slug": "article",
        "label": "Article",
        "icon": "newspaper",
        "group": "Content"
    },
    "layout": [
        {
            "id": "tabs_details",
            "kind": "tabs",
            "slots": [
                { "id": "tab_publishing", "label": "Publishing" },
                { "id": "tab_media", "label": "Media" }
            ]
        },
        {
            "id": "columns_contact",
            "kind": "columns",
            "label": "Contact",
            "slots": [
                { "id": "col_left", "label": "Left" },
                { "id": "col_right", "label": "Right" }
            ]
        },
        {
            "id": "section_advanced",
            "kind": "section",
            "label": "Advanced",
            "slots": [{ "id": "slot_advanced" }]
        }
    ],
    "fields": [
        {
            "uuid": "0f4c7a52-8f3e-4b8e-9a51-3c2d1e6f7a01",
            "key": "title",
            "label": "Title",
            "type": "text",
            "helper": "Shown as the headline.",
            "required": true,
            "filterable": true,
            "layout_slot": null,
            "settings": {
                "placeholder": "A clear, short headline",
                "default": "",
                "max_length": 120
            }
        },
        {
            "uuid": "1a2b3c4d-5e6f-4a7b-8c9d-0e1f2a3b4c02",
            "key": "summary",
            "label": "Summary",
            "type": "textarea",
            "helper": "One or two sentences for lists and search results.",
            "required": false,
            "filterable": false,
            "layout_slot": null,
            "settings": { "rows": 3 }
        },
        {
            "uuid": "2b3c4d5e-6f7a-4b8c-9d0e-1f2a3b4c5d03",
            "key": "body",
            "label": "Body",
            "type": "rich_text",
            "required": false,
            "filterable": false,
            "layout_slot": null,
            "settings": {}
        },
        {
            "uuid": "3c4d5e6f-7a8b-4c9d-8e1f-2a3b4c5d6e04",
            "key": "category",
            "label": "Category",
            "type": "select",
            "required": true,
            "filterable": true,
            "layout_slot": "tab_publishing",
            "settings": {
                "options": {
                    "kind": "static",
                    "options": [
                        { "value": "news", "label": "News" },
                        { "value": "guide", "label": "Guide" },
                        { "value": "opinion", "label": "Opinion" }
                    ]
                },
                "multiple": false
            }
        },
        {
            "uuid": "4d5e6f7a-8b9c-4d0e-9f2a-3b4c5d6e7f05",
            "key": "status",
            "label": "Status",
            "type": "radio",
            "required": true,
            "filterable": true,
            "layout_slot": "tab_publishing",
            "settings": {
                "options": {
                    "kind": "static",
                    "options": [
                        { "value": "draft", "label": "Not ready" },
                        { "value": "review", "label": "In review" },
                        { "value": "live", "label": "Published" }
                    ]
                }
            }
        },
        {
            "uuid": "5e6f7a8b-9c0d-4e1f-8a3b-4c5d6e7f8a06",
            "key": "published_at",
            "label": "Publish date",
            "type": "datetime",
            "required": false,
            "filterable": true,
            "layout_slot": "tab_publishing",
            "settings": { "date_only": false }
        },
        {
            "uuid": "6f7a8b9c-0d1e-4f2a-9b4c-5d6e7f8a9b07",
            "key": "featured",
            "label": "Feature on the home page",
            "type": "checkbox",
            "required": false,
            "filterable": true,
            "layout_slot": "tab_publishing",
            "settings": { "default": false }
        },
        {
            "uuid": "7a8b9c0d-1e2f-4a3b-8c5d-6e7f8a9b0c08",
            "key": "topics",
            "label": "Topics",
            "type": "checkboxes",
            "required": false,
            "filterable": false,
            "layout_slot": "tab_publishing",
            "settings": {
                "options": {
                    "kind": "static",
                    "options": [
                        { "value": "local", "label": "Local" },
                        { "value": "business", "label": "Business" },
                        { "value": "culture", "label": "Culture" }
                    ]
                }
            }
        },
        {
            "uuid": "8b9c0d1e-2f3a-4b4c-9d6e-7f8a9b0c1d09",
            "key": "reading_time",
            "label": "Reading time (minutes)",
            "type": "number",
            "required": false,
            "filterable": true,
            "layout_slot": "tab_publishing",
            "settings": { "whole": true, "min": 1, "max": 120, "step": null }
        },
        {
            "uuid": "9c0d1e2f-3a4b-4c5d-8e7f-8a9b0c1d2e10",
            "key": "quality",
            "label": "Editor rating",
            "type": "range",
            "required": false,
            "filterable": false,
            "layout_slot": "tab_publishing",
            "settings": { "min": 0, "max": 10, "step": 1 }
        },
        {
            "uuid": "a0b1c2d3-e4f5-4a6b-9c7d-8e9f0a1b2c11",
            "key": "cover",
            "label": "Cover image",
            "type": "file",
            "required": false,
            "filterable": false,
            "layout_slot": "tab_media",
            "settings": { "multiple": false, "accept": ["image/*"] }
        },
        {
            "uuid": "b1c2d3e4-f5a6-4b7c-8d8e-9f0a1b2c3d12",
            "key": "attachments",
            "label": "Attachments",
            "type": "file",
            "required": false,
            "filterable": false,
            "layout_slot": "tab_media",
            "settings": { "multiple": true, "accept": [".pdf", ".docx"] }
        },
        {
            "uuid": "c2d3e4f5-a6b7-4c8d-9e9f-0a1b2c3d4e13",
            "key": "accent_color",
            "label": "Accent colour",
            "type": "color",
            "required": false,
            "filterable": false,
            "layout_slot": "tab_media",
            "settings": { "default": "#1e40af" }
        },
        {
            "uuid": "d3e4f5a6-b7c8-4d9e-8f0a-1b2c3d4e5f14",
            "key": "author_email",
            "label": "Author email",
            "type": "email",
            "required": false,
            "filterable": true,
            "layout_slot": "col_left",
            "settings": { "placeholder": "name@example.com", "default": "" }
        },
        {
            "uuid": "e4f5a6b7-c8d9-4e0f-9a1b-2c3d4e5f6a15",
            "key": "source_url",
            "label": "Source link",
            "type": "url",
            "required": false,
            "filterable": false,
            "layout_slot": "col_right",
            "settings": { "placeholder": "", "default": "" }
        },
        {
            "uuid": "f5a6b7c8-d9e0-4f1a-8b2c-3d4e5f6a7b16",
            "key": "related_page",
            "label": "Related page",
            "type": "select",
            "required": false,
            "filterable": false,
            "layout_slot": "slot_advanced",
            "settings": {
                "options": {
                    "kind": "model",
                    "model": "page",
                    "label_field": "title"
                },
                "multiple": false
            }
        },
        {
            "uuid": "a6b7c8d9-e0f1-4a2b-9c3d-4e5f6a7b8c17",
            "key": "region",
            "label": "Region",
            "type": "radio",
            "required": false,
            "filterable": true,
            "layout_slot": "slot_advanced",
            "settings": {
                "options": { "kind": "hook", "name": "regions.list" }
            }
        },
        {
            "uuid": "b7c8d9e0-f1a2-4b3c-8d4e-5f6a7b8c9d18",
            "key": "embed",
            "label": "Embed code",
            "type": "code",
            "helper": "Pasted from a video or map provider.",
            "required": false,
            "filterable": false,
            "layout_slot": "slot_advanced",
            "settings": { "language": "html" }
        },
        {
            "uuid": "c8d9e0f1-a2b3-4c4d-9e5f-6a7b8c9d0e19",
            "key": "legacy_id",
            "label": "Old site id",
            "type": "hidden",
            "required": false,
            "filterable": true,
            "layout_slot": "slot_advanced",
            "settings": { "default": "" }
        }
    ]
}
